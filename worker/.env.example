# MongoDB (nombre de servicio Docker: mongoserver)
MONGO_URI=mongodb://mongoserver:27017/taskflow

# Redis (nombre de servicio Docker: redisserver)
REDIS_HOST=redisserver
REDIS_PORT=6379

# Concurrencia del Worker (cantidad de solicitudes procesadas en paralelo)
WORKER_CONCURRENCY=2

# Intervalo (ms) del latido de vida enviado a Redis para el Monitor
HEARTBEAT_INTERVAL_MS=5000

# Tiempo (ms) simulado de procesamiento de cada solicitud
PROCESSING_DELAY_MS=2000
