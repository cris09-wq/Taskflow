# Puerto interno del backend
PORT=4000

# MongoDB Atlas (nube). Pega aquí tu connection string de Atlas
# (Connect > Drivers) con la base de datos "taskflow":
#   mongodb+srv://<usuario>:<contrasena>@<cluster>.mongodb.net/taskflow
MONGO_URI=mongodb+srv://<usuario>:<contrasena>@<cluster>.mongodb.net/taskflow

# Redis local (nombre de servicio Docker: redisserver)
# Si usas Docker Compose, levanta Redis con: docker compose up -d redisserver
REDIS_HOST=localhost
REDIS_PORT=6379

# TTL de la caché de solicitudes (segundos)
CACHE_TTL=60

# Origen permitido para CORS (frontend)
CORS_ORIGIN=http://localhost:5173
