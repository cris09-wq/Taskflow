# Puerto interno del backend
PORT=4000

# MongoDB (nombre de servicio Docker: mongoserver)
MONGO_URI=mongodb://mongoserver:27017/taskflow

# Redis (nombre de servicio Docker: redisserver)
REDIS_HOST=redisserver
REDIS_PORT=6379

# TTL de la caché de solicitudes (segundos)
CACHE_TTL=60

# Origen permitido para CORS (frontend)
CORS_ORIGIN=http://localhost:5173
